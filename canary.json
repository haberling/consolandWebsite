{
  "site": { "name": "Consoland", "baseUrl": "https://consoland.net" },
  "content": { "root": "content" },
  "output": { "dir": "docs" },
  "renderMode": "hybrid",
  "nav": { "depth": 2 },
  "serve": { "port": 6913 },
  "theme": {
    "shell": "shell.html",
    "base": "css/framework.css",
    "theme": "css/theme.css",
    "logo": "img/logo.png",
    "favicon": "img/logo.png"
  },
  "widgets": { "copyDefaultsOnInit": false, "preferBuiltIn": true },
  "tools": {
    "blog-list-generator": "dotnet run tools/blog-list-generator.cs",
    "clear-metadata": "dotnet run tools/clear-metadata.cs",
    "format-blogpost-new": "dotnet run tools/format-blogpost.cs -- new",
    "format-blogpost-archive": "dotnet run tools/format-blogpost.cs -- archive"
  },
  "publish": "dotnet run tools/publish.cs"
}
